{
  "$schemaComment": "BitCroupier — bilanciamento giocabile (B3/B4). Documentazione completa: config/README.md. Modificare qui senza toccare il codice core.",
  "schemaVersion": 3,
  "accounting": {
    "payWinningsOnly": true,
    "amountDueFormula": "sum(stake * multiplier) per winning bets on seat",
    "overpayCostsEnergy": true,
    "overpayEnergyPenalty": 1,
    "timeoutUnpaidCostsEnergy": true,
    "timeoutEnergyPenalty": 1
  },
  "payTime": {
    "minSeconds": 4,
    "formula": "max(minSeconds, payTimeBaseSeconds + winnerBonusSecondsPerWinner * winnerCount)",
    "comment": "winnerBonus kept modest so multi-WIN still tightens pressure (was 1.5).",
    "winnerBonusSecondsPerWinner": 1
  },
  "automaticFlow": {
    "comment": "Arcade wave: tutorial seat, then fill hunt board quickly. seatsAddedPerStep expands active roster toward preset.playerCount.",
    "bettingSeconds": 3,
    "firstRoundPaySeconds": 15,
    "firstRoundSeatCount": 1,
    "roundsPerAdditionalSeat": 1,
    "seatsAddedPerStep": 2,
    "closedBetsPauseMs": 280,
    "resultHoldMs": 420,
    "nextRoundDelayMs": 600,
    "firstRoundGuaranteedWinner": true
  },
  "serviceScore": {
    "seatCompleteComboPoints": [10, 15, 20],
    "wrongPlayerPenalty": 5,
    "perfectServiceBonus": 20,
    "speedPointsPerWholeSecond": 1,
    "timeoutScorePenalty": 0,
    "autoPaidSeatPoints": 0,
    "minPoints": 0
  },
  "wallet": {
    "unitsPerServiceScorePoint": 1
  },
  "autoplay": {
    "walletEarnedUnits": 0
  },
  "playerMode": {
    "minBuyIn": 5,
    "starterScore": 1000,
    "chipDenominations": [1, 2, 5, 10, 100, 500],
    "defaultChip": 10,
    "scenicNpcCount": 3,
    "reBuyMidSession": false,
    "manualSpin": true,
    "fullBankrollOnEnter": true,
    "comment": "A fresh/legacy-zero profile receives starterScore once. 1 point = 1 chip unit. Full score on enter (no bring steps). Manual SPIN. Rebet/Double in UI. Chip tray 1–500. scenicNpcCount is unused in UI. Multipliers stay in bets-*.json only."
  },
  "chipDenominationsAllowed": [5, 10, 25, 50],
  "levelUpEffects": {
    "comment": "Each +1 LEVEL softens pay base (hunt pressure). Floor prevents impossible timers. Other rotation names kept for config compatibility.",
    "rotation": [
      "payTimeSoftDown",
      "payTimeSoftDown",
      "payTimeSoftDown"
    ],
    "payTimeSoftDownSeconds": 0.5,
    "payTimeBaseFloorSeconds": 4,
    "npcStakeMeanUpPercent": 5,
    "interSpinDownSeconds": 1,
    "chipStepOrderDescending": [50, 25, 10, 5]
  },
  "bonusRoll": {
    "enabledDefault": true,
    "maxOnePerPayout": true
  },
  "customRanges": {
    "playerCount": { "min": 1, "max": 24 },
    "interSpinSeconds": { "min": 10, "max": 90 },
    "payTimeBaseSeconds": { "min": 4, "max": 24 },
    "chipValue": { "allowed": [5, 10, 25, 50] },
    "energy": { "min": 2, "max": 6 },
    "startLevel": { "min": 1, "max": 20 }
  },
  "presets": {
    "training": {
      "id": "training",
      "labelKey": "difficulty.training",
      "playerCount": 10,
      "interSpinSeconds": 50,
      "payTimeBaseSeconds": 12,
      "chipValue": 25,
      "energyStart": 5,
      "energyMax": 5,
      "startLevel": 1,
      "maxLevel": 15,
      "roundsPerLevelUp": 3,
      "bonusChance": 0.32
    },
    "standard": {
      "id": "standard",
      "labelKey": "difficulty.standard",
      "playerCount": 14,
      "interSpinSeconds": 35,
      "payTimeBaseSeconds": 9,
      "chipValue": 10,
      "energyStart": 3,
      "energyMax": 3,
      "startLevel": 1,
      "maxLevel": 40,
      "roundsPerLevelUp": 3,
      "bonusChance": 0.22
    },
    "busy": {
      "id": "busy",
      "labelKey": "difficulty.busy",
      "playerCount": 18,
      "interSpinSeconds": 25,
      "payTimeBaseSeconds": 7,
      "chipValue": 10,
      "energyStart": 3,
      "energyMax": 3,
      "startLevel": 1,
      "maxLevel": 60,
      "roundsPerLevelUp": 2,
      "bonusChance": 0.18
    },
    "rush": {
      "id": "rush",
      "labelKey": "difficulty.rush",
      "playerCount": 20,
      "interSpinSeconds": 15,
      "payTimeBaseSeconds": 6,
      "chipValue": 5,
      "energyStart": 3,
      "energyMax": 3,
      "startLevel": 3,
      "maxLevel": 99,
      "roundsPerLevelUp": 2,
      "bonusChance": 0.14
    }
  },
  "defaultPresetId": "standard",
  "tableVariantDefault": "european"
}
