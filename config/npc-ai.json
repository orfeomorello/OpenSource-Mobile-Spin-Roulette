{
  "$schemaComment": "MobileSpinRoulette — NPC betting AI (B6). Full docs: config/README.md. Edit weights/ranges without changing core code.",
  "schemaVersion": 1,
  "leaveWhenBroke": true,
  "betPlacement": {
    "maxBetsPerNpc": 3,
    "countWeights": {
      "0": 0.1,
      "1": 0.45,
      "2": 0.3,
      "3": 0.15
    },
    "delayFractionOfBettingWindow": { "min": 0.1, "max": 0.9 }
  },
  "stake": {
    "multiplesOfTableChip": [1, 2, 3, 5],
    "multipleWeights": [0.5, 0.3, 0.15, 0.05],
    "maxStakeFractionOfBankroll": 0.25
  },
  "bankrollByPreset": {
    "training": { "min": 200, "max": 400 },
    "standard": { "min": 150, "max": 500 },
    "busy": { "min": 100, "max": 600 },
    "rush": { "min": 80, "max": 400 },
    "custom": { "min": 150, "max": 500 }
  },
  "profiles": {
    "cautious": {
      "weight": 0.25,
      "stakeMultipleScale": 0.7,
      "familyBias": { "outsideSimple": 1.6, "outsideDozenColumn": 1.1, "insideMedium": 0.5, "insideStraight": 0.25, "zeroFamily": 0.2 }
    },
    "normal": {
      "weight": 0.5,
      "stakeMultipleScale": 1.0,
      "familyBias": { "outsideSimple": 1.0, "outsideDozenColumn": 1.0, "insideMedium": 1.0, "insideStraight": 1.0, "zeroFamily": 1.0 }
    },
    "aggressive": {
      "weight": 0.15,
      "stakeMultipleScale": 1.4,
      "familyBias": { "outsideSimple": 0.6, "outsideDozenColumn": 1.0, "insideMedium": 1.4, "insideStraight": 1.8, "zeroFamily": 1.2 }
    },
    "superstitious": {
      "weight": 0.1,
      "stakeMultipleScale": 1.0,
      "familyBias": { "outsideSimple": 0.9, "outsideDozenColumn": 0.8, "insideMedium": 1.1, "insideStraight": 1.5, "zeroFamily": 1.3 },
      "repeatFavoriteChance": 0.35
    }
  },
  "betFamilyBaseWeights": {
    "comment": "Relative weights before profile bias; covers full standard catalog",
    "outsideSimple": {
      "weight": 40,
      "bets": ["red", "black", "even", "odd", "low", "high"]
    },
    "outsideDozenColumn": {
      "weight": 18,
      "bets": ["dozen1", "dozen2", "dozen3", "column1", "column2", "column3"]
    },
    "insideMedium": {
      "weight": 25,
      "bets": ["split", "street", "corner", "sixLine", "trio", "firstFour"]
    },
    "insideStraight": {
      "weight": 12,
      "bets": ["straight"]
    },
    "zeroFamily": {
      "weight": 5,
      "bets": ["straight0", "trioZero", "firstFour", "fiveNumber", "split0_00"],
      "americanOnly": ["fiveNumber", "split0_00"],
      "europeanOnly": []
    }
  },
  "levelScaling": {
    "comment": "Optional multipliers applied from game-balance level-up; AI reads current table modifiers",
    "useTableStakeMeanModifier": true
  },
  "names": {
    "comment": "Display names can also live in i18n; optional pool here",
    "pool": [
      "Alex", "Bea", "Chen", "Dee", "Evan", "Fay", "Gus", "Hana",
      "Ivy", "Jo", "Kai", "Liv", "Mo", "Noa", "Oli", "Pip",
      "Quin", "Rae", "Sam", "Tess", "Uma", "Val", "Wes", "Xan"
    ]
  }
}
