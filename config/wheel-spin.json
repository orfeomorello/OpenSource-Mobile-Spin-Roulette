{
  "$schemaComment": "MobileSpinRoulette — SpinEngine v2 (ball–wheel ODE + CSPRNG). Outcome only; canvas is presenter. Docs: config/README.md · src/spin/spinEngine.ts",
  "schemaVersion": 2,
  "engine": "ball_wheel_ode_v1",
  "rules": {
    "sameResultWithOrWithoutAnimation": true,
    "noPocketProbabilityZeroOrOne": true,
    "scoreDoesNotAffectWinningNumber": true,
    "comment": "Outcome from CSPRNG initial conditions plus numerical ball/wheel dynamics. Animation never re-rolls the pocket."
  },
  "variants": {
    "european": {
      "pockets": [
        "0", "32", "15", "19", "4", "21", "2", "25", "17", "34", "6", "27", "13", "36",
        "11", "30", "8", "23", "10", "5", "24", "16", "33", "1", "20", "14", "31", "9",
        "22", "18", "29", "7", "28", "12", "35", "3", "26"
      ],
      "pocketCount": 37,
      "colors": {
        "comment": "Standard European: 0 green; reds/blacks as classic wheel",
        "green": ["0"],
        "red": ["1", "3", "5", "7", "9", "12", "14", "16", "18", "19", "21", "23", "25", "27", "30", "32", "34", "36"],
        "black": ["2", "4", "6", "8", "10", "11", "13", "15", "17", "20", "22", "24", "26", "28", "29", "31", "33", "35"]
      }
    },
    "american": {
      "pockets": [
        "0", "28", "9", "26", "30", "11", "7", "20", "32", "17", "5", "22", "34", "15",
        "3", "24", "36", "13", "1", "00", "27", "10", "25", "29", "12", "8", "19", "31",
        "18", "6", "21", "33", "16", "4", "23", "35", "14", "2"
      ],
      "pocketCount": 38,
      "colors": {
        "green": ["0", "00"],
        "red": ["1", "3", "5", "7", "9", "12", "14", "16", "18", "19", "21", "23", "25", "27", "30", "32", "34", "36"],
        "black": ["2", "4", "6", "8", "10", "11", "13", "15", "17", "20", "22", "24", "26", "28", "29", "31", "33", "35"]
      }
    }
  },
  "simulation": {
    "comment": "Angular units rad/s (abstract). Ball drag: dω/dt = -sign(ω)*(alpha + beta*|ω|). Wheel speed constant for one spin. Drop when |ω_ball| <= dropSpeedThreshold.",
    "wheelAngularSpeed": { "min": 0.85, "max": 1.55 },
    "ballAngularSpeed": { "min": 2.6, "max": 5.4 },
    "ballDrag": {
      "alpha": { "min": 0.09, "max": 0.15 },
      "beta": { "min": 0.13, "max": 0.22 }
    },
    "dropSpeedThreshold": 0.45,
    "fretsScatterPockets": {
      "maxAbs": 1,
      "comment": "After geometric drop, shift pocket index by U{-maxAbs…+maxAbs} (frets / diamond noise). 0 disables."
    },
    "ballDirection": -1,
    "wheelDirection": 1,
    "integrationDt": 0.004,
    "maxSimSeconds": 18
  },
  "animation": {
    "comment": "Presenter only — does not change winningNumber. durationFromSim scales wall-clock show length from sim time.",
    "defaultDurationSeconds": 7,
    "durationFromSim": true,
    "durationScale": 1.15,
    "minDurationSeconds": 5,
    "maxDurationSeconds": 7.5
  },
  "api": {
    "function": "spin(tableVariant, rng?) -> { winningNumber, durationMs, turns, finalAngle }",
    "detailed": "spinDetailed(tableVariant, rng?) -> { result, debug }",
    "winningNumberType": "string pocket id e.g. \"0\" | \"00\" | \"17\"",
    "rng": "Optional () => number in [0,1). Default: crypto.getRandomValues (CSPRNG)."
  }
}
